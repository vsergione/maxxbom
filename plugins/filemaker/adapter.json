{
  "id": "filemaker",
  "name": "FileMaker",
  "version": "1.0.0",
  "description": "Searches the product catalog and reads or updates offer lines in FileMaker.",
  "settings": [
    {
      "key": "catalog_api_url",
      "role": "catalog_url",
      "label": "Catalog API URL",
      "type": "url",
      "placeholder": "https://example.com/.../query_products",
      "hint": "Searches products and subgroups."
    },
    {
      "key": "import_api_url",
      "role": "import_url",
      "label": "Import into FileMaker URL",
      "type": "url",
      "placeholder": "https://example.com/.../import-sketch",
      "hint": "Writes the design into the FileMaker offer."
    },
    {
      "key": "offer_lines_api_url",
      "role": "offer_lines_url",
      "label": "Get offer lines from FileMaker URL",
      "type": "url",
      "placeholder": "https://example.com/.../get-offer-lines",
      "hint": "Reads the current offer lines.",
      "when_unset": {
        "from": "import_api_url",
        "replace": ["import-sketch", "get-offer-lines"]
      }
    },
    {
      "key": "api_key",
      "role": "api_key",
      "label": "API Key",
      "type": "password",
      "hint": "Sent with catalog search, import, and offer-lines requests."
    }
  ],
  "catalog": {
    "method": "POST",
    "auth": { "location": "query", "name": "apiKey" },
    "request": { "query_path": "query", "limit_path": "resultLimit" },
    "response": {
      "items_path": "scriptResult.result",
      "fallback_items_paths": ["results", "data"],
      "fields": { "code": "code", "name": "name", "unit": "unit", "category": "category" }
    }
  },
  "orders": {
    "auth": { "location": "query", "name": "apiKey" },
    "load": {
      "method": "POST",
      "url": "{{offer_lines_url}}",
      "request": { "offer_id_path": "offer_id" },
      "response": {
        "items_path": "scriptResult.result",
        "fallback_items_paths": ["result"]
      }
    },
    "export": {
      "method": "POST",
      "url": "{{import_url}}",
      "request": { "offer_id_path": "offer_id", "items_path": "items" }
    },
    "fields": {
      "id": "id",
      "code": "code",
      "quantity": "quantity",
      "uom": "uom",
      "category": "category"
    }
  }
}
